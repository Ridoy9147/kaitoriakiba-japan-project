# Normalize line endings: store text as LF in the repo, check out native on each OS.
* text=auto

# Explicit text types
*.php    text
*.css    text
*.js     text
*.json   text
*.md     text
*.pot    text
*.svg    text
*.txt    text

# Binary assets (never line-ending-normalized or diffed as text)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
